<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="🦋 花影羚羊"
            android:textSize="28sp"
            android:textColor="#E0E0E0"
            android:textStyle="bold" />

        <!-- 副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="3D 桌面宠物"
            android:textSize="16sp"
            android:textColor="#78909C"
            android:gravity="center" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:text="🌙 花影羚羊在休息..."
            android:textSize="18sp"
            android:textColor="#B0BEC5"
            android:gravity="center"
            android:background="#1A1F2E"
            android:backgroundTint="#1A1F2E" />

        <!-- 按钮 -->
        <Button
            android:id="@+id/actionBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/start_service"
            android:textSize="17sp"
            android:backgroundTint="#7C4DFF"
            android:textColor="#FFFFFF"
            android:elevation="4dp" />

        <!-- 提示文字 -->
        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"
            android:padding="20dp"
            android:textSize="14sp"
            android:textColor="#78909C"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:background="#1A1F2E"
            android:alpha="0.9" />

        <!-- 功能特性 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="16dp"
            android:text="🐏 3D立体Q版造型\n🌸 花瓣纹样装饰\n🦋 生态模拟系统\n☀️ 昼夜交替/天气变化\n👆 多点触摸互动\n🌙 自主AI行为\n🎵 程序化音效"
            android:textSize="13sp"
            android:textColor="#546E7A"
            android:lineSpacingExtra="4dp"
            android:background="#111827"
            android:alpha="0.8" />

    </LinearLayout>

</ScrollView>
